{
    "_comment": "Freqtrade Prod 標準測試 Config - Futures (合約)",
    "_usage": "freqtrade backtesting --config user_data/config/backtest_futures_standard.json --strategy <STRATEGY> --timerange <TIMERANGE>",
    
    "trading_mode": "futures",
    "margin_mode": "isolated",
    
    "stake_currency": "USDT",
    "stake_amount": 50,
    "tradable_balance_ratio": 0.99,
    "dry_run": true,
    "dry_run_wallet": 1000,
    "timeframe": "5m",
    
    "cancel_open_orders_on_exit": false,
    "ignore_buying_expired_candle_after": 30,
    
    "trailing_stop": false,
    "stoploss": -0.10,
    
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false,
        "stoploss_on_exchange_interval": 60
    },
    
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    
    "exchange": {
        "name": "bybit",
        "sandbox": false,
        "key": "",
        "secret": "",
        "slippage_allowed": 0.001,
        "ccxt_config": {
            "enableRateLimit": true,
            "options": {
                "adjustForTimeDifference": true,
                "recvWindow": 60000
            },
            "fee": 0.0006
        },
        "ccxt_async_config": {
            "enableRateLimit": true,
            "rateLimit": 50
        },
        "pair_blacklist": []
    },
    
    "pairlists": [
        {
            "method": "RemotePairList",
            "pairlist_url": "file:///user_data/config/coinmarketcap-pairlist.json",
            "number_assets": 50,
            "refresh_period": 1800,
            "keep_pairlist_on_failure": true,
            "read_timeout": 60
        }
    ],
    
    "max_open_trades": 3,
    "position_adjustment_enable": false,
    "max_entry_position_adjustment": -1,
    
    "minimal_roi": {
        "0": 0.05,
        "30": 0.03,
        "60": 0.015,
        "120": 0.005
    },
    
    "process_only_new_candles": true,
    "use_exit_signal": true,
    "exit_profit_only": false,
    "exit_profit_offset": 0.0,
    "ignore_roi_if_entry_signal": false
}
