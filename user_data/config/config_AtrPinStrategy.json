{
    "max_open_trades": 5,
    "stake_currency": "USDT",
    "stake_amount": 10,
    "tradable_balance_ratio": 0.9,
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "strategy": "AtrPinStrategy",
    "timeframe": "5m",
    "stoploss": -0.05,
    "process_only_new_candles": true,
    "position_adjustment_enable": true,
    "unfilledtimeout": {
        "entry": 1,
        "exit": 1,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false,
        "stoploss_on_exchange_interval": 60
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "bybit",
        "sandbox": false,
        "key": "",
        "secret": "",
        "slippage_allowed": 0.002,
        "ccxt_config": {
            "enableRateLimit": true,
            "options": {
                "adjustForTimeDifference": true,
                "recvWindow": 30000,
                "defaultType": "swap"
            },
            "fee": 0.001,
            "leverage": 1
        },
        "ccxt_async_config": {
            "enableRateLimit": true,
            "rateLimit": 30
        },
        // "pair_whitelist": [
        // ],
        "pair_blacklist": [
            ".*BEAR.*",
            ".*BULL.*",
            "XRP/USDT:USDT",
            "XLM/USDT:USDT",
            "XMR/USDT:USDT",
            "ZEC/USDT:USDT",
            "WLFI/USDT:USDT"
        ]
    },
    "pairlists": [
        {
            "method": "RemotePairList",
            "pairlist_url": "file:///user_data/config/coinmarketcap-future-pairlist.json",
            "number_assets": 15,
            "refresh_period": 1800,
            "keep_pairlist_on_failure": true,
            "read_timeout": 60
        }
    ],
    "bot_name": "AtrPinStrategy",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 1
    },
    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "username": "freqtrade",
        "password": "FreqtradePassword"
    },
    "telegram": {
        "enabled": false,
        "token": "dummy_token",
        "chat_id": "dummy_chat_id"
    }
}