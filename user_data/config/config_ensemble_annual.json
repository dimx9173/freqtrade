{
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.95,
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",

  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },

  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",

  "exchange": {
    "name": "binance",
    "key": "kfubX0XvGx4NG8N3eQbYKFKW1EbOFLwZyjGA9tFhFXYMOaPjCjsGc91AGsJxQIge",
    "secret": "3HdqHJaaB3YASdh4YMGNChTyUiWx4KSLWFLAfvs8fYW8pkyQCV9x4RmBIizdG3RX",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT"
    ],
    "pair_blacklist": [],
    "markets_refresh_interval": 60
  },

  "pairlists": [
    {
      "method": "StaticPairList",
      "number_assets": 2
    }
  ],

  "timeframe": "5m",

  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },

  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 14008,
    "verbosity": "info",
    "jwt_secret_key": "change-me-annual-ensemble",
    "CORS_origins": ["http://localhost:8080"],
    "username": "",
    "password": ""
  },

  "bot_name": "ensemble_annual_bot",
  "initial_state": "running",
  "force_entry_enable": false,

  "internals": {
    "process_throttle_secs": 1,
    "allowed_trials": 5
  },

  "freqai": {
    "enabled": true,
    "identifier": "ensemble_annual_2024",
    "freqaimodel": "HybridEnsembleRegressor",
    "train_period_days": 60,
    "backtest_period_days": 7,

    "data_split_parameters": {
      "test_size": 0.15,
      "shuffle": false,
      "random_state": 42
    },

    "feature_parameters": {
      "include_timeframes": ["5m", "15m"],
      "include_corr_pairlist": [
        "BTC/USDT:USDT",
        "ETH/USDT:USDT"
      ],
      "include_shifted_candles": 2,
      "label_period_candles": 1,
      "indicator_periods_candles": [5, 13, 21, 55],
      "DI_threshold": 0.8,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": true,
      "weight_factor": 0.85,
      "noise_standard_deviation": 0.0005,
      "buffer_train_data_candles": 50
    },

    "model_training_parameters": {
      "lightgbm": {
        "n_estimators": 200,
        "learning_rate": 0.08,
        "max_depth": 6,
        "min_child_samples": 20,
        "subsample": 0.85,
        "colsample_bytree": 0.85,
        "reg_alpha": 0.02,
        "reg_lambda": 0.02,
        "random_state": 42,
        "verbose": -1,
        "n_jobs": -1
      },
      "xgboost": {
        "n_estimators": 200,
        "learning_rate": 0.08,
        "max_depth": 6,
        "min_child_weight": 5,
        "subsample": 0.85,
        "colsample_bytree": 0.85,
        "reg_alpha": 0.02,
        "reg_lambda": 0.02,
        "random_state": 42,
        "verbosity": 0,
        "n_jobs": -1
      },
      "deep_learning": {
        "sequence_length": 20,
        "epochs": 50,
        "batch_size": 32,
        "learning_rate": 0.005,
        "early_stopping_patience": 10,
        "phase5b_enhanced": {
          "use_attention": true,
          "cnn_filters": [64, 128, 256],
          "cnn_kernel_sizes": [3, 5, 7],
          "lstm_hidden_size": 128,
          "lstm_num_layers": 3,
          "dropout": 0.3,
          "use_bidirectional": true
        }
      },
      "meta_model": {
        "n_estimators": 100,
        "learning_rate": 0.05,
        "max_depth": 4,
        "random_state": 42,
        "verbose": -1
      },
      "phase5c_meta_intelligence": {
        "num_base_models": 5,
        "meta_hidden_size": 128,
        "reliability_threshold": 0.65,
        "confidence_threshold": 0.75,
        "performance_window": 100,
        "learning_rate": 0.005
      },
      "phase5d_online_learning": {
        "learning_rate": 0.01,
        "adaptation_window": 50,
        "retraining_threshold": 0.08,
        "drift_threshold": 0.08,
        "warning_threshold": 0.04,
        "retrain_cooldown": 100,
        "max_retrains_per_hour": 1,
        "buffer_size_multiplier": 2.0
      }
    },

    "extra_returns_per_train": {
      "&-ensemble_prediction_mean": 0.0,
      "&-ensemble_prediction_std": 0.0,
      "&-price_target_mean": 0.0,
      "&-price_target_std": 0.0,
      "ensemble_confidence_mean": 0.0,
      "model_consensus_mean": 0.0,
      "market_regime_trend": 0.0,
      "market_regime_volatility": 0.0
    },

    "multitarget_parallel_training": false,
    "purge_old_models": 5,
    "save_backtest_models": true,
    "follow_mode": false,
    "continual_learning": true,
    "write_metrics_to_disk": true,

    "rl_config": {
      "return_reward_reduction": false
    }
  },

  "edge": {
    "enabled": false
  }
}