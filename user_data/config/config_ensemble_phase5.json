{
  "max_open_trades": 15,
  "stake_currency": "USDT",
  "stake_amount": 125,
  "tradable_balance_ratio": 0.95,
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",

  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": true,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },

  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",

  "exchange": {
    "name": "binance",
    "key": "kfubX0XvGx4NG8N3eQbYKFKW1EbOFLwZyjGA9tFhFXYMOaPjCjsGc91AGsJxQIge",
    "secret": "3HdqHJaaB3YASdh4YMGNChTyUiWx4KSLWFLAfvs8fYW8pkyQCV9x4RmBIizdG3RX",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "BNB/USDT:USDT",
      "SOL/USDT:USDT",
      "ADA/USDT:USDT",
      "XRP/USDT:USDT",
      "MATIC/USDT:USDT",
      "AVAX/USDT:USDT",
      "DOT/USDT:USDT",
      "LINK/USDT:USDT",
      "UNI/USDT:USDT",
      "ATOM/USDT:USDT",
      "NEAR/USDT:USDT",
      "FTM/USDT:USDT",
      "ALGO/USDT:USDT"
    ],
    "pair_blacklist": [],
    "markets_refresh_interval": 60
  },

  "pairlists": [
    {
      "method": "StaticPairList",
      "number_assets": 15
    }
  ],

  "timeframe": "5m",

  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },

  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 14002,
    "verbosity": "info",
    "jwt_secret_key": "change-me-phase5",
    "CORS_origins": ["http://localhost:8080"],
    "username": "",
    "password": ""
  },

  "bot_name": "ensemble_phase5_bot",
  "initial_state": "running",
  "force_entry_enable": false,

  "internals": {
    "process_throttle_secs": 1,
    "allowed_trials": 5
  },

  "freqai": {
    "enabled": true,
    "identifier": "ensemble_phase5d_realtime_ultimate",
    "freqaimodel": "HybridEnsembleRegressor",
    "train_period_days": 15,
    "backtest_period_days": 2,

    "data_split_parameters": {
      "test_size": 0.15,
      "shuffle": false,
      "random_state": 42
    },

    "feature_parameters": {
      "include_timeframes": ["5m", "15m"],
      "include_corr_pairlist": [
        "BTC/USDT:USDT",
        "ETH/USDT:USDT",
        "BNB/USDT:USDT"
      ],
      "include_shifted_candles": 2,
      "label_period_candles": 2,
      "indicator_periods_candles": [3, 5, 8, 13, 21],
      "DI_threshold": 0.6,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": true,
      "weight_factor": 0.8,
      "noise_standard_deviation": 0.001,
      "buffer_train_data_candles": 30
    },

    "model_training_parameters": {
      "lightgbm": {
        "n_estimators": 200,
        "learning_rate": 0.05,
        "max_depth": 6,
        "min_child_samples": 10,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "reg_alpha": 0.1,
        "reg_lambda": 0.1,
        "random_state": 42,
        "verbose": -1,
        "n_jobs": -1
      },
      "xgboost": {
        "n_estimators": 150,
        "learning_rate": 0.08,
        "max_depth": 5,
        "min_child_weight": 3,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "reg_alpha": 0.05,
        "reg_lambda": 0.05,
        "random_state": 42,
        "verbosity": 0,
        "n_jobs": -1
      },
      "deep_learning": {
        "sequence_length": 20,
        "epochs": 100,
        "batch_size": 32,
        "learning_rate": 0.001,
        "early_stopping_patience": 20,
        "phase5b_enhanced": {
          "use_attention": true,
          "cnn_filters": [64, 128, 256],
          "cnn_kernel_sizes": [3, 5, 7],
          "lstm_hidden_size": 128,
          "lstm_num_layers": 3,
          "dropout": 0.3,
          "use_bidirectional": true
        }
      },
      "meta_model": {
        "n_estimators": 100,
        "learning_rate": 0.1,
        "max_depth": 4,
        "random_state": 42,
        "verbose": -1
      },
      "phase5c_meta_intelligence": {
        "num_base_models": 6,
        "meta_hidden_size": 128,
        "reliability_threshold": 0.7,
        "confidence_threshold": 0.8,
        "performance_window": 100,
        "learning_rate": 0.001
      },
      "phase5d_online_learning": {
        "learning_rate": 0.01,
        "adaptation_window": 50,
        "retraining_threshold": 0.05,
        "drift_threshold": 0.05,
        "warning_threshold": 0.03,
        "retrain_cooldown": 100,
        "max_retrains_per_hour": 3,
        "buffer_size_multiplier": 2
      }
    },

    "extra_returns_per_train": {
      "&-ensemble_prediction_mean": 0.0,
      "&-ensemble_prediction_std": 0.0,
      "&-price_target_mean": 0.0,
      "&-price_target_std": 0.0,
      "&-volatility_target_mean": 0.0,
      "&-volatility_target_std": 0.0,
      "&-trend_target_mean": 0.0,
      "&-trend_target_std": 0.0,
      "&-volume_target_mean": 0.0,
      "&-volume_target_std": 0.0,
      "ensemble_confidence_mean": 0.0,
      "model_consensus_mean": 0.0,
      "phase5b_cnn_lstm_weight": 0.0,
      "phase5b_transformer_weight": 0.0,
      "phase5b_tft_weight": 0.0,
      "phase5b_wavenet_weight": 0.0,
      "phase5c_meta_reliability": 0.0,
      "phase5c_adaptive_confidence": 0.0,
      "phase5d_online_learning_active": 0.0,
      "phase5d_concept_drift_detected": 0.0,
      "phase5d_retraining_frequency": 0.0
    },

    "multitarget_parallel_training": true,
    "purge_old_models": 7,
    "save_backtest_models": true,
    "follow_mode": false,
    "continual_learning": false,
    "write_metrics_to_disk": true,

    "rl_config": {
      "return_reward_reduction": false
    }
  },

  "edge": {
    "enabled": false,
    "process_throttle_secs": 3600,
    "calculate_since_number_of_days": 7,
    "allowed_risk": 0.01,
    "stoploss_range_min": -0.01,
    "stoploss_range_max": -0.1,
    "stoploss_range_step": -0.01,
    "minimum_winrate": 0.60,
    "minimum_expectancy": 0.20,
    "min_trade_number": 10,
    "max_trade_duration_minute": 1440,
    "remove_pumps": false
  }
}