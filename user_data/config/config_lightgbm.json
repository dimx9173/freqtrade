{
  "max_open_trades": 5,
  "stake_currency": "USDT",
  "stake_amount": 200,
  "tradable_balance_ratio": 0.99,
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",

  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },

  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",

  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "ETH/USDT",
      "BTC/USDT"
    ],
    "pair_blacklist": [],
    "markets_refresh_interval": 60
  },



  "pairlists": [
    {
      "method": "StaticPairList",
      "number_assets": 2
    }
  ],

  "timeframe": "5m",

  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },

  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 14000,
    "verbosity": "info",
    "jwt_secret_key": "change-me",
    "CORS_origins": ["http://localhost:8080"],
    "username": "",
    "password": ""
  },

  "bot_name": "lightgbm_freqai_bot",
  "initial_state": "running",
  "force_entry_enable": false,

  "internals": { "process_throttle_secs": 5 },

  "freqai": {
    "enabled": true,
    "identifier": "lightgbm_eth_hyperopt",
    "train_period_days": 56,
    "backtest_period_days": 14,
    "prediction_model": "LightGBMRegressorMultiTarget",
    "data_split_parameters": {
      "test_size": 0.15,
      "shuffle": false
    },
    "feature_parameters": {
      "include_timeframes": ["5m"],
      "include_corr_pairlist": [],
      "include_shifted_candles": 3,
      "label_period_candles": 24,
      "indicator_periods_candles": [10, 20, 50, 100]
    },
    "model_training_parameters": {
      "n_estimators": 1000,
      "learning_rate": 0.05,
      "max_depth": 8,
      "num_leaves": 31,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "reg_alpha": 0.1,
      "reg_lambda": 0.1,
      "min_child_samples": 20,
      "random_state": 42,
      "n_jobs": -1,
      "verbose": -1
    },
    "extra_returns_per_train": {
      "&-s_close_mean": 0,
      "&-s_close_std": 0,
      "&-s_range_mean": 0,
      "&-s_range_std": 0
    },
    "multitarget_parallel_training": true,
    "purge_old_models": 2,
    "save_backtest_models": true,
    "follow_mode": false,
    "continual_learning": false
  }
}


