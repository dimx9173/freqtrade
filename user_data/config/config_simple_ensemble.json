{
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.95,
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",

  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },

  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",

  "exchange": {
    "name": "binance",
    "key": "kfubX0XvGx4NG8N3eQbYKFKW1EbOFLwZyjGA9tFhFXYMOaPjCjsGc91AGsJxQIge",
    "secret": "3HdqHJaaB3YASdh4YMGNChTyUiWx4KSLWFLAfvs8fYW8pkyQCV9x4RmBIizdG3RX",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT"
    ],
    "pair_blacklist": [],
    "markets_refresh_interval": 60
  },

  "pairlists": [
    {
      "method": "StaticPairList",
      "number_assets": 2
    }
  ],

  "timeframe": "5m",

  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },

  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 14010,
    "verbosity": "info",
    "jwt_secret_key": "change-me-simple-ensemble",
    "CORS_origins": ["http://localhost:8080"],
    "username": "",
    "password": ""
  },

  "bot_name": "simple_ensemble_bot",
  "initial_state": "running",
  "force_entry_enable": false,

  "internals": {
    "process_throttle_secs": 1,
    "allowed_trials": 5
  },

  "freqai": {
    "enabled": true,
    "identifier": "simple_ensemble",
    "freqaimodel": "SimpleEnsembleRegressor",
    "train_period_days": 7,
    "backtest_period_days": 2,

    "data_split_parameters": {
      "test_size": 0.25,
      "shuffle": false,
      "random_state": 42
    },

    "feature_parameters": {
      "include_timeframes": ["5m"],
      "include_corr_pairlist": [
        "BTC/USDT:USDT"
      ],
      "include_shifted_candles": 2,
      "label_period_candles": 1,
      "indicator_periods_candles": [10, 20],
      "DI_threshold": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "weight_factor": 0.95,
      "noise_standard_deviation": 0.0,
      "buffer_train_data_candles": 20
    },

    "model_training_parameters": {
      "ensemble_params": {
        "min_samples_required": 20,
        "validation_split": 0.2,
        "random_state": 42
      }
    },

    "multitarget_parallel_training": false,
    "purge_old_models": 3,
    "save_backtest_models": false,
    "follow_mode": false,
    "continual_learning": false,
    "write_metrics_to_disk": true,

    "rl_config": {
      "return_reward_reduction": false
    }
  },

  "edge": {
    "enabled": false
  }
}