{
  "max_open_trades": 6,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.9,
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",

  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": true,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },

  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",

  "exchange": {
    "name": "binance",
    "key": "kfubX0XvGx4NG8N3eQbYKFKW1EbOFLwZyjGA9tFhFXYMOaPjCjsGc91AGsJxQIge",
    "secret": "3HdqHJaaB3YASdh4YMGNChTyUiWx4KSLWFLAfvs8fYW8pkyQCV9x4RmBIizdG3RX",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "BNB/USDT:USDT",
      "SOL/USDT:USDT"
    ],
    "pair_blacklist": [],
    "markets_refresh_interval": 60
  },

  "pairlists": [
    {
      "method": "StaticPairList",
      "number_assets": 4
    }
  ],

  "timeframe": "5m",

  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },

  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 14004,
    "verbosity": "info",
    "jwt_secret_key": "phase5-simple-test",
    "CORS_origins": ["http://localhost:8080"],
    "username": "",
    "password": ""
  },

  "bot_name": "ensemble_phase5_simple",
  "initial_state": "running",
  "force_entry_enable": false,

  "internals": {
    "process_throttle_secs": 1,
    "allowed_trials": 5
  },

  "freqai": {
    "enabled": true,
    "identifier": "ensemble_phase5_simple_test",
    "freqaimodel": "HybridEnsembleRegressor",
    "train_period_days": 10,
    "backtest_period_days": 1,

    "data_split_parameters": {
      "test_size": 0.25,
      "shuffle": false,
      "random_state": 42
    },

    "feature_parameters": {
      "include_timeframes": ["5m"],
      "include_corr_pairlist": [
        "BTC/USDT:USDT",
        "ETH/USDT:USDT"
      ],
      "include_shifted_candles": 1,
      "label_period_candles": 1,
      "indicator_periods_candles": [5, 10, 20],
      "DI_threshold": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "weight_factor": 1.0,
      "noise_standard_deviation": 0,
      "buffer_train_data_candles": 20
    },

    "model_training_parameters": {
      "lightgbm": {
        "n_estimators": 100,
        "learning_rate": 0.1,
        "max_depth": 4,
        "min_child_samples": 20,
        "subsample": 0.9,
        "colsample_bytree": 0.9,
        "reg_alpha": 0.1,
        "reg_lambda": 0.1,
        "random_state": 42,
        "verbose": -1,
        "n_jobs": -1
      },
      "xgboost": {
        "n_estimators": 100,
        "learning_rate": 0.1,
        "max_depth": 4,
        "min_child_weight": 5,
        "subsample": 0.9,
        "colsample_bytree": 0.9,
        "reg_alpha": 0.1,
        "reg_lambda": 0.1,
        "random_state": 42,
        "verbosity": 0,
        "n_jobs": -1
      },
      "deep_learning": {
        "sequence_length": 10,
        "epochs": 50,
        "batch_size": 32,
        "learning_rate": 0.001,
        "early_stopping_patience": 10,
        "phase5b_enhanced": {
          "use_attention": false,
          "cnn_filters": [32, 64],
          "cnn_kernel_sizes": [3, 5],
          "lstm_hidden_size": 64,
          "lstm_num_layers": 2,
          "dropout": 0.2,
          "use_bidirectional": false
        }
      },
      "meta_model": {
        "n_estimators": 50,
        "learning_rate": 0.1,
        "max_depth": 3,
        "random_state": 42,
        "verbose": -1
      }
    },

    "extra_returns_per_train": {
      "&-ensemble_prediction_mean": 0.0,
      "&-ensemble_prediction_std": 0.0
    },

    "multitarget_parallel_training": false,
    "purge_old_models": 3,
    "save_backtest_models": false,
    "follow_mode": false,
    "continual_learning": false,
    "write_metrics_to_disk": false,

    "rl_config": {
      "return_reward_reduction": false
    }
  },

  "edge": {
    "enabled": false
  }
}