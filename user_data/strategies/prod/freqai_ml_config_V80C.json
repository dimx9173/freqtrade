{
    "freqai": {
        "enabled": true,
        "purge_old_models": 2,
        "train_period_days": 30,
        "backtest_period_days": 7,
        "live_retrain_hours": 0,
        "identifier": "FreqAI_v80C_classifier",
        "save_backtest_models": true,
        "continual_learning": false,
        "feature_parameters": {
            "include_timeframes": [
                "15m",
                "1h",
                "4h"
            ],
            "include_corr_pairlist": [
                "BTC/USDT:USDT",
                "ETH/USDT:USDT",
                "SOL/USDT:USDT",
                "XRP/USDT:USDT",
                "LTC/USDT:USDT"
            ],
            "label_period_candles": 24,
            "include_shifted_candles": 3,
            "DI_threshold": 0.85,
            "weight_factor": 0.85,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": true,
            "indicator_periods_candles": [
                10,
                20,
                50
            ],
            "plot_feature_importances": 0,
            "multiclass_labels": true,
            "labels_ctr": {
                "sideways": 0,
                "uptrend": 1,
                "downtrend": 2,
                "volatile": 3
            }
        },
        "data_split_parameters": {
            "test_size": 0.25,
            "shuffle": false
        },
        "model_training_parameters": {
            "n_estimators": 800,
            "learning_rate": 0.03,
            "max_depth": 8,
            "colsample_bytree": 0.9,
            "subsample": 0.9,
            "reg_alpha": 0.3,
            "reg_lambda": 0.3,
            "min_child_samples": 150,
            "num_leaves": 40
        },
        "xgboost_params": {
            "tree_method": "hist",
            "device": "cuda"
        }
    },
    "kelly": {
        "enabled": true,
        "kelly_fraction": 0.5,
        "win_rate_lookback_trades": 50,
        "avg_win_loss_lookback_trades": 50,
        "min_trades_for_kelly": 10,
        "kelly_max_position_pct": 1.0,
        "kelly_min_position_mult": 0.3,
        "kelly_max_position_mult": 2.0
    }
}